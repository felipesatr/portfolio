# Copy to .env.spotify.local. Server/setup credentials only; NEVER prefix VITE_.
SPOTIFY_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
SPOTIFY_CLIENT_SECRET=ENTER_DIRECTLY_IN_THIS_IGNORED_LOCAL_FILE
# Register exactly this in Spotify's developer dashboard. Not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8788/callback
